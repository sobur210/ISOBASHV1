generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  FAILED
  CANCELLED
}

enum AgentRunStatus {
  PENDING
  PLANNING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentStepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum MemoryKind {
  FACT
  PREFERENCE
  SUMMARY
  NOTE
}

enum ResearchStatus {
  PENDING
  SEARCHING
  RETRIEVING
  ANSWERING
  COMPLETED
  FAILED
}

enum ResearchSourceStatus {
  PENDING
  FETCHED
  REJECTED
  FAILED
}

/// Phase 12 files. A stored file is either being turned into knowledge
/// (PROCESSING), is searchable (READY), or failed for a recorded reason.
enum FileStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}


/// Phase 13 media. A generation is only COMPLETED when a provider really returned
/// bytes that are now stored; anything else records the provider's own error.
enum MediaGenerationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum UserRole {
  ADMIN
  USER
}

/// Phase 16 billing. The plan catalogue is code, not data: two plans whose
/// limits are known at build time. This enum only ever holds a value the
/// catalogue defines.
enum PlanKey {
  FREE
  PRO
}

/// A user on a plan above FREE. There is deliberately no status and no billing
/// period: no payment processor is configured in this deployment, so a
/// subscription row means exactly "this account holds this entitlement", granted
/// by an admin. Absence of a row is the FREE plan, which is also the default, so
/// no user is ever left without one.
model Subscription {
  id     Int      @id @default(autoincrement())
  userId Int      @unique
  plan   PlanKey  @default(FREE)

  /// The admin who granted it. Null means nobody granted it (it was never
  /// upgraded), which is different from "granted by the system".
  grantedById Int?
  /// Why it was granted, recorded so an entitlement is never unexplained.
  note     String?
  grantedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy  User? @relation("SubscriptionGrants", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([plan])
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  passwordHash String?
  role      UserRole @default(USER)
  mfaSecret String?
  mfaEnabledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLoginAt DateTime?

  projects  Project[]
  tasks     Task[]
  conversations Conversation[]
  notifications Notification[]
  sessions  Session[]
  agents    Agent[]
  agentRuns AgentRun[]
  memories  MemoryEntry[]
  researchSessions ResearchSession[]
  files        StoredFile[]
  imageGenerations ImageGeneration[]
  videoGenerations VideoGeneration[]
  mediaAssets  MediaAsset[]
  /// Credits this user spent on metered providers. Attribution for the admin view,
  /// not a separate allowance: the provider bills one shared pool.
  providerCreditEntries ProviderCreditEntry[]
  /// The plan this account holds above the FREE default. Absent = FREE.
  subscription Subscription?
  /// Subscriptions this account granted to other accounts.
  subscriptionsGranted Subscription[] @relation("SubscriptionGrants")
}

model AuditEvent {
  id         Int      @id @default(autoincrement())
  category   String // AUTH | AUTHORIZATION | ADMIN | SECURITY
  action     String // register, login, login_failed, logout, mfa_enabled, mfa_disabled, forbidden, admin_access, ...
  actorId    Int?
  actorEmail String?
  ip         String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([category, createdAt])
  @@index([actorId, createdAt])
  @@index([actorEmail, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     Int
  owner       User     @relation(fields: [ownerId], references: [id])
  tasks       Task[]
  agents      Agent[]
  memories    MemoryEntry[]
  conversations Conversation[]
  researchSessions ResearchSession[]
  files        StoredFile[]
  imageGenerations ImageGeneration[]
  videoGenerations VideoGeneration[]
  mediaAssets  MediaAsset[]

  @@index([ownerId, updatedAt])
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  status      TaskStatus @default(TODO)
  order       Int        @default(0)
  result      String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  projectId   Int
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId  Int?
  assignee    User?      @relation(fields: [assigneeId], references: [id])

  agentRunId  String?
  agentRun    AgentRun?  @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([projectId, order, createdAt])
  @@index([status])
}

model Agent {
  id            String   @id @default(cuid())
  name          String
  description   String?
  instructions  String   @default("")
  providerModel String?
  maxSteps      Int      @default(6)
  toolNames     String[] @default([])
  memoryEnabled Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerId   Int
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  runs     AgentRun[]
  memories MemoryEntry[]

  @@index([ownerId, updatedAt])
  @@index([projectId])
}

model AgentRun {
  id                String         @id @default(cuid())
  status            AgentRunStatus @default(PENDING)
  input             String
  output            String?
  error             String?
  plan              Json?
  provider          String?
  model             String?
  stepsExecuted     Int            @default(0)
  cancelRequestedAt DateTime?
  startedAt         DateTime?
  finishedAt        DateTime?
  createdAt         DateTime       @default(now())

  agentId  String
  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  ownerId  Int
  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  steps    AgentStep[]
  tasks    Task[]

  @@index([agentId, createdAt])
  @@index([ownerId, createdAt])
  @@index([status])
}

model AgentStep {
  id         String          @id @default(cuid())
  position   Int
  title      String
  tool       String?
  input      Json?
  output     String?
  error      String?
  status     AgentStepStatus @default(PENDING)
  durationMs Int?
  createdAt  DateTime        @default(now())

  runId   String
  run     AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, position])
  @@index([runId, position])
}

model MemoryEntry {
  id             String     @id @default(cuid())
  kind           MemoryKind @default(NOTE)
  content        String
  source         String     @default("manual")
  sourceId       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastAccessedAt DateTime?

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([agentId, updatedAt])
  @@index([projectId, updatedAt])
}

model ResearchSession {
  id        String         @id @default(cuid())
  question  String
  status    ResearchStatus @default(PENDING)
  answer    String?
  error     String?
  /// Set when the model read the sources and reported they do not answer the question.
  /// An honest "no evidence found" result, which is different from an uncited answer.
  noEvidence Boolean       @default(false)
  /// How the sources were found: "search" (a real search provider), "supplied" (URLs
  /// the caller gave), or both. Never a value implying retrieval that did not happen.
  retrieval String         @default("none")
  queries   String[]       @default([])
  provider  String?
  model     String?
  searchedAt DateTime?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  userId    Int
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int?
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sources   ResearchSource[]
  citations ResearchCitation[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
}

model ResearchSource {
  id          String               @id @default(cuid())
  url         String
  /// The URL the fetch actually landed on after redirects, so a cited page can be
  /// traced to its canonical location.
  finalUrl    String?
  title       String?
  host        String?
  status      ResearchSourceStatus @default(PENDING)
  detail      String?
  httpStatus  Int?
  /// The extracted plain text the model actually read. Capped, never truncated silently.
  content     String               @default("")
  characters  Int                  @default(0)
  origin      String               @default("supplied")
  fetchedAt   DateTime?

  sessionId String
  session   ResearchSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  citations ResearchCitation[]

  @@unique([sessionId, url])
  @@index([sessionId, status])
}

model ResearchCitation {
  id        String   @id @default(cuid())
  marker    String
  quote     String
  /// Set when the quote could not be found verbatim in the source text, so the UI can
  /// mark the citation as unverified instead of presenting it as evidence.
  verified  Boolean  @default(false)

  sessionId String
  session   ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sourceId  String
  source    ResearchSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sessionId, marker])
  @@index([sourceId])
}

model StoredFile {
  id           String     @id @default(cuid())
  /// The name the uploader chose. Never used as a path: the bytes live under
  /// `relativePath`, which the server generates and validates.
  originalName String
  relativePath String
  extension    String     @default("")
  /// The type decided from the bytes, not from the client's claim:
  /// text | markdown | csv | json | html | pdf | image | archive | unknown
  kind         String     @default("unknown")
  mimeType     String
  sizeBytes    Int
  /// Per-user content identity: the same bytes cannot be stored twice.
  sha256       String
  status       FileStatus @default(PENDING)
  /// Why the file could not be processed, or could only be partially indexed.
  error        String?
  /// Set when the file is searchable but something was skipped, e.g. no embedding
  /// provider. Never used to hide a failure: `error` is the failure channel.
  warning      String?
  extractable  Boolean    @default(false)
  extractedText String    @default("")
  characters   Int        @default(0)
  /// How many knowledge chunks this file currently has. Denormalised so a list
  /// does not have to count a child table per row.
  chunkCount   Int        @default(0)
  truncated    Boolean    @default(false)
  embeddingModel String?
  embeddedAt   DateTime?
  processedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  userId    Int
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  chunks FileChunk[]

  @@unique([userId, sha256])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([projectId, createdAt])
  @@index([kind])
}

model FileChunk {
  id        String @id @default(cuid())
  ordinal   Int
  content   String
  characters Int
  /// A cheap, honest size estimate (4 characters per token). Never presented as
  /// a real tokenizer count.
  tokenEstimate Int
  /// The embedding as a JSON number array. Postgres has no vector extension here,
  /// so similarity is computed in the API against the caller's own chunks.
  embedding       Json?
  embeddingModel  String?
  embeddedAt      DateTime?
  createdAt DateTime @default(now())

  fileId String
  file   StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, ordinal])
  @@index([fileId])
}

/// Phase 13 image generation. One row per request the caller made; the bytes live
/// on disk under a server-generated path and are described by `MediaAsset` rows.
/// A run is COMPLETED only when a provider really returned images that are stored.
model ImageGeneration {
  id             String                @id @default(cuid())
  /// Exactly what the caller typed. Never overwritten by the prompt enhancer, so
  /// the run stays readable back to the words the user actually wrote.
  prompt         String
  /// The expanded prompt that was really sent to the renderer (the original plus
  /// the style preset, and the text model's rewrite when enhancement is on). Null
  /// when nothing expanded it, in which case the renderer was given `prompt` as-is.
  enhancedPrompt String?
  /// The style preset id applied, e.g. "cinematic". Null means no preset.
  style          String?
  /// What the caller asked the provider for, e.g. "16:9". Null when the provider
  /// default was used, so the column never claims a ratio nobody requested.
  aspectRatio    String?
  /// How many images were asked for. `assets` can hold fewer, and `error` then
  /// says why the rest are missing.
  requestedCount Int                   @default(1)
  status         MediaGenerationStatus @default(PENDING)
  /// The provider's error, verbatim and truncated for storage. Never a paraphrase
  /// presented as a success.
  error          String?
  errorCode      String?
  /// Set when the run succeeded but something was skipped, e.g. one of the four
  /// requested images was refused by the provider. Never used to hide a failure:
  /// `error` is the failure channel and `warning` is not one.
  warning        String?
  /// The provider's own finish reason (STOP, IMAGE_SAFETY, PROHIBITED_CONTENT, …).
  /// This is the provider's verdict, not a moderation classifier ISOBASH runs.
  finishReason   String?
  provider       String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  cancelRequestedAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assets MediaAsset[]

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
}

/// Phase 14. Text-to-video, plus image-to-video by animating a stored image the
/// caller already owns. The state machine mirrors `ImageGeneration` deliberately:
/// a run is COMPLETED only when real bytes were decoded out of the container and
/// written to disk.
model VideoGeneration {
  id             String                @id @default(cuid())
  prompt         String
  /// What the caller asked the provider for, e.g. "16:9". Null when the provider
  /// default was used, so the column never claims a ratio nobody requested.
  aspectRatio    String?
  /// Length in whole seconds that was asked for. The stored asset carries the
  /// duration read from the container, which is what actually got rendered.
  requestedSeconds Int                 @default(4)
  status         MediaGenerationStatus @default(PENDING)
  /// The provider's error, verbatim and truncated for storage.
  error          String?
  errorCode      String?
  /// Set when the run succeeded but something was degraded, e.g. the container
  /// carried no audio track or the render came back shorter than requested.
  warning        String?
  /// The provider's own finish reason / status (STOP, SAFETY, PROHIBITED_CONTENT, …).
  finishReason   String?
  provider       String?
  model          String?
  /// The provider's own id for this render, written the moment its project is
  /// created rather than on completion. A queued job retried after a worker dies
  /// resumes this project instead of submitting a second one, which against a
  /// shared credit pool would mean paying twice for one clip. Null until a
  /// provider project exists.
  providerProjectId String?
  /// How far along the render is, where the provider reports it. Null means the
  /// provider reports no progress, which is a fact about the provider rather than
  /// a gap in the record, so no number is invented to fill it.
  progressPercent  Int?
  inputTokens    Int?
  outputTokens   Int?
  cancelRequestedAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The stored image used as the first frame, for an image-to-video run. Null
  /// for text-to-video. The asset is referenced, never copied or mutated, so
  /// deleting the image later does not rewrite history on the run.
  sourceAssetId String?
  sourceAsset   MediaAsset?  @relation("VideoSourceAsset", fields: [sourceAssetId], references: [id], onDelete: SetNull)

  assets MediaAsset[] @relation("VideoGenerationAssets")

  /// The credit this run reserved, if it touched a metered provider. One row, so a
  /// retried reservation cannot become a second charge.
  creditEntry ProviderCreditEntry?

  @@index([userId, createdAt])
  @@index([projectId, createdAt])
  @@index([status])
}

/// A generated file. `relativePath` is generated by the server and validated
/// against traversal; the absolute path never leaves the process.
model MediaAsset {
  id           String    @id @default(cuid())
  kind         MediaKind @default(IMAGE)
  relativePath String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  /// Phase 14: playback length read from the container header, in milliseconds.
  /// Null for an image, and for a video whose header carries no readable
  /// duration. An unmeasurable duration is left null rather than estimated from
  /// the length that was requested.
  durationMs   Int?
  /// Phase 14: whether the container declares an audio track. Null when the
  /// container could not be parsed for one.
  hasAudio     Boolean?
  /// Content identity of the stored bytes, so a damaged file is detectable on read
  /// rather than served as if it were intact.
  sha256       String
  /// The provider's own note about the image, when it returned one.
  note         String?
  /// Copied from the generation so an asset stays readable without its parent row.
  prompt       String?
  /// The expanded prompt actually sent to the renderer, copied from the
  /// generation. Null when nothing expanded it.
  enhancedPrompt String?
  /// The style preset id applied, copied from the generation. Null means none.
  style        String?
  aspectRatio  String?
  provider     String?
  model        String?
  createdAt    DateTime  @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  generationId String?
  generation   ImageGeneration? @relation(fields: [generationId], references: [id], onDelete: SetNull)

  videoGenerationId String?
  videoGeneration   VideoGeneration? @relation("VideoGenerationAssets", fields: [videoGenerationId], references: [id], onDelete: SetNull)

  /// Set on an image that was used as the first frame of a video run.
  usedAsVideoSource VideoGeneration[] @relation("VideoSourceAsset")

  @@index([userId, createdAt])
  @@index([generationId])
  @@index([videoGenerationId])
  @@index([projectId, createdAt])
  @@index([kind])
}

/// Phase 15: where a render sits in the provider's credit lifecycle.
///
/// The distinction exists because a provider reports a cost twice and the two
/// numbers mean different things. Before rendering it quotes an ESTIMATE, and the
/// money is only notionally committed; after the real output frame rate is known it
/// revises that to the actual charge, which can be higher or lower. A failed render
/// is refunded, so a terminal failure can legitimately report less than the
/// estimate taken a moment earlier. Collapsing these into one "cost" column would
/// make a refunded render look identical to a successful one.
enum ProviderCreditState {
  /// An estimate was taken and a render was submitted. The outcome is not known yet,
  /// so the credits are treated as spent for the purpose of the pool guard.
  RESERVED
  /// The provider reported the final cost. This is the only state that is a fact.
  CHARGED
  /// The provider failed the render and refunded the estimate. The credits came
  /// back, so the run is visible at zero cost rather than absent.
  REFUNDED
  /// The reservation was taken but no render was ever created, for example because
  /// the request was rejected locally. Exists so a run that reserved and released
  /// cannot be mistaken for one that was never attempted.
  RELEASED
}

/// Phase 15: one row per render that touched a metered provider account.
///
/// This is a global, account-level ledger rather than a per-user one, and that is
/// the point: Magic Hour bills a single key, so two ISOBASH users rendering at the
/// same moment are spending from the same pool. Attributing the cost to a user is
/// still recorded, but it is attribution, not a separate allowance.
model ProviderCreditEntry {
  id String @id @default(cuid())

  /// Provider key, e.g. `magic-hour`. Kept generic so a second metered provider
  /// gets its own ledger without a new table.
  provider String

  /// Billing month as `YYYY-MM` in UTC. Pinned to UTC deliberately: a pool that
  /// resets at the operator's local midnight would make "credits left this month"
  /// depend on the server's timezone.
  month String

  state ProviderCreditState @default(RESERVED)

  /// Credits taken from the pool when the render was submitted. Always populated,
  /// even for runs that never reached the provider, because this is the number the
  /// guard reserved against.
  estimatedCredits Int

  /// The provider's final figure, once it has reported one.
  chargedCredits Int?

  /// Credits the provider gave back, for a refunded render.
  refundedCredits Int?

  model String?

  /// The provider's own project id, so a run can be traced into the provider's
  /// dashboard and a completed render can be reconciled after an ISOBASH restart.
  providerProjectId String?

  /// Why the state is what it is, in ISOBASH's own words, e.g. the provider's
  /// error message for a refund.
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One ledger row per run. The uniqueness is the safety net for a retried
  /// reservation: a second reserve for the same run is a bug, not a new charge.
  videoGenerationId String  @unique
  videoGeneration   VideoGeneration @relation(fields: [videoGenerationId], references: [id], onDelete: Cascade)

  /// Who spent it. Recorded for the admin view; there is no per-user quota here.
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, month, state])
  @@index([userId, createdAt])
}

/// Phase 15: the provider's own account balance, as last observed.
///
/// Separate from the ledger because the two disagree, and when they do the
/// provider is right. The ledger only sees renders ISOBASH started, so it is blind
/// to anything spent outside ISOBASH and to a reservation made before a reinstall.
/// This is the number the pool guard trusts, and the ledger is the record of who
/// spent what.
model ProviderCreditSnapshot {
  id String @id @default(cuid())

  provider String
  month String

  /// Credits left on the provider account, as the provider reported them.
  balance Int

  /// When the balance was read, so a stale snapshot is visible rather than being
  /// silently treated as current.
  recordedAt DateTime @default(now())

  /// How this balance was obtained: the provider's account endpoint, or a
  /// pessimistic guess when the endpoint could not be reached. A guard that cannot
  /// read the balance must not behave as though the pool is full.
  source String @default("provider")

  @@unique([provider, month])
}

model Notification {
  id        Int      @id @default(autoincrement())
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Conversation {
  id              String    @id @default(cuid())
  title           String    @default("New conversation")
  status          String    @default("active")
  clientSessionId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  userId    Int?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  projectId Int?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  messages  Message[]

  @@index([clientSessionId, updatedAt])
  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  role           String
  content        String       @default("")
  provider       String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  error          String?
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String

  @@index([conversationId, createdAt])
}
