# Public URL used by browser and server frontend requests. For a single-origin
# deployment this is the frontend URL; Next forwards backend paths internally.
NEXT_PUBLIC_API_URL="https://app.example.com"

# Canonical public URL of this Next.js app. Used for metadata and sharing URLs.
NEXT_PUBLIC_WEB_URL="https://app.example.com"

# Private URL where the Next server can reach the backend process.
INTERNAL_API_URL="http://backend:3001"
