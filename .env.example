DATABASE_URL="postgresql://postgres:postgres@localhost:5432/isobash?schema=public"
REDIS_URL="redis://localhost:6380"
PORT=3001
WEB_URL="http://localhost:3002"
API_URL="http://localhost:3001"

# Canonical web origin. Must match the port `next dev` is pinned to in
# apps/frontend/package.json, or backend CORS and Next metadataBase drift.
NEXT_PUBLIC_WEB_URL="http://localhost:3002"

# Browser-visible API base URL used by the Next.js frontend (lib/api.ts) and by
# the frontend CSP (next.config.ts). Local development uses the frontend
# gateway on port 3002; Next forwards backend routes to API_URL on port 3001.
# The NEXT_PUBLIC_ prefix is required: Next.js inlines these values into the
# client bundle at build time. Read by `next dev`/`next build` from
# apps/frontend/.env.local, NOT from this root .env. Keep the two in sync.
# NEXT_PUBLIC_API_URL="http://localhost:3002"

# Extra browser origins allowed to call the API with credentials, comma separated.
# WEB_URL is always allowed. Leave unset to allow only WEB_URL.
# CORS_ORIGINS="http://localhost:3002,http://127.0.0.1:3000"

# Security: used to encrypt MFA TOTP secrets at rest (AES-256-GCM) and sign sensitive values.
# Generate with: openssl rand -base64 32
APP_SECRET="change-me-to-a-long-random-string"

# Brute-force / abuse protection (fixed-window per IP unless noted)
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=30
RATE_LIMIT_REGISTER_WINDOW_MS=900000
RATE_LIMIT_MFA_MAX=10
RATE_LIMIT_MFA_WINDOW_MS=900000
RATE_LIMIT_LOGIN_FAILURES_MAX=5
RATE_LIMIT_LOGIN_FAILURES_WINDOW_MS=900000

# Runtime data roots (defaults resolve beside the repository)
DATA_ROOT=
UPLOAD_ROOT=
MEDIA_ROOT=
TEMP_ROOT=
LOGS_ROOT=
CACHE_ROOT=
KNOWLEDGE_ROOT=
MODEL_ROOT=

# Local AI (Ollama)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:latest"

# Cloud AI (OpenAI-compatible adapter; requires OPENAI_API_KEY when enabled)
OPENAI_ENABLED=false
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_API_KEY="set-locally-only"

# Cloud AI (Gemini; requires GEMINI_API_KEY when enabled)
# gemini-3.7-flash is a stable GA model on the free tier. Older ids such as
# gemini-2.5-flash are retired for newly provisioned keys (HTTP 404).
GEMINI_ENABLED=false
GEMINI_MODEL="gemini-3.7-flash"
# GEMINI_API_KEY="set-locally-only"

# ---------------------------------------------------------------------------
# Research (Phase 11)
# Search is optional. Without BRAVE_SEARCH_API_KEY the API reports the search
# provider as unavailable and research only reads the URLs you supply.
# ---------------------------------------------------------------------------
# BRAVE_SEARCH_API_KEY="set-locally-only"
# RESEARCH_MAX_SOURCES=6                  # 1-20 source pages per session
# RESEARCH_MAX_CHARS_PER_SOURCE=20000     # characters kept per fetched page
# RESEARCH_FETCH_TIMEOUT_MS=10000         # per-request fetch timeout
# RESEARCH_ALLOW_PRIVATE_HOSTS=false       # TEST ONLY: allows 127.0.0.1/private
                                          # targets, e.g. for verifier fixtures.
                                          # Never enable in production: the
                                          # default blocks loopback, link-local,
                                          # and private ranges to stop SSRF.

# ---------------------------------------------------------------------------
# Local service supervisor (scripts/service.mjs + scripts/win/*.ps1)
# The Windows Scheduled Task "ISOBASH-Service" runs `service.mjs start` at boot
# and at logon, so the API (3001), web (3000) and the BullMQ worker come up
# without anyone starting them. All values below are optional.
# ---------------------------------------------------------------------------
# WEB_PORT=3000
# SERVICE_WEB_MODE=production        # production | development (next dev)
# SERVICE_MANAGE_INFRA=true          # start PostgreSQL/Redis/Ollama when down
# SERVICE_MANAGE_OLLAMA=true
# SERVICE_AUTOBUILD=true             # build missing/stale artifacts on start
# SERVICE_KILL_STALE=true            # free ports 3000/3001 held by stale processes
# SERVICE_HEALTH_INTERVAL_MS=15000
# SERVICE_PROBE_FAILURE_THRESHOLD=3
# SERVICE_RESTART_BACKOFF_MAX_MS=30000
# SERVICE_TASK_NAME=ISOBASH-Service
# REDIS_SERVER_PATH=C:/laragon/bin/redis/redis-x64-5.0.14.1/redis-server.exe
# REDIS_DATA_DIR=C:/laragon/Isobash-Redis
# OLLAMA_BIN=C:/Users/<you>/AppData/Local/Programs/Ollama/ollama.exe
# OLLAMA_MODELS=C:/Users/<you>/.ollama/models   # required when the task runs as SYSTEM

# ---------------------------------------------------------------------------
# Files, document indexing and knowledge search (Phase 12)
# Uploads are validated by size, extension, byte signature and UTF-8 validity
# before anything is written, and the stored path is always server-generated.
# ---------------------------------------------------------------------------
# FILES_MAX_BYTES=10485760                 # 10 MiB per file
# FILES_MAX_FILES_PER_USER=200             # stored files per account
# FILES_MAX_TOTAL_BYTES_PER_USER=209715200 # 200 MiB of uploads per account
# FILES_CHUNK_SIZE=1200                    # characters per knowledge chunk
# FILES_CHUNK_OVERLAP=200                  # repeated characters between chunks
# FILES_MAX_CHUNKS_PER_FILE=400            # bounds work and storage per file
# FILES_MAX_EXTRACTED_CHARS=400000         # extracted text kept per file
# FILES_MAX_PREVIEW_CHARS=20000            # characters returned by /files/:id/text
# FILES_SEARCH_CANDIDATE_LIMIT=5000        # chunks scored per knowledge search
# FILES_EMBEDDINGS_ENABLED=true            # false keeps keyword-only search
# FILES_EMBEDDINGS_PROVIDER=auto           # auto | ollama | gemini | openai
# FILES_EMBEDDINGS_MODEL=                  # optional explicit embedding model

# Embedding models offered by each provider. Only models that actually exist on
# the configured provider can be selected; nothing is assumed to be pulled.
# AI_EMBEDDING_MODELS_OLLAMA="nomic-embed-text,mxbai-embed-large"
# AI_EMBEDDING_MODELS_GEMINI="gemini-embedding-001,text-embedding-004"
# AI_EMBEDDING_MODELS_OPENAI="text-embedding-3-small,text-embedding-3-large"
# FILES_MIN_VECTOR_SIMILARITY=0.55        # cosine floor for a dense hit; a query
                                          # that means nothing scores ~0.4-0.5
                                          # against everything, so without a floor
                                          # "no match" and "least irrelevant"
                                          # look identical.
# FILES_MIN_VECTOR_MARGIN=0.06            # the best chunk must lead the rest
                                          # by this much to count as relevant

# ---------------------------------------------------------------------------
# Image generation (Phase 13)
# Generation needs a provider that really serves images. A key whose plan grants
# no image quota answers 429 and the failure is surfaced verbatim. Nothing is
# substituted or faked, and the API reports the last real provider error.
# ---------------------------------------------------------------------------
# GEMINI_IMAGE_ENABLED=true              # expose Gemini as an image provider
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"
# GEMINI_IMAGE_BILLING_ENABLED=false
#                                         # Set true once billing is actually
#                                         # enabled on the Gemini project. This does
#                                         # two things: it makes the Gemini image
#                                         # model eligible for automatic routing,
#                                         # and it registers an operator
#                                         # preference so Gemini wins image
#                                         # routing outright. The preference
#                                         # matters because provider health is
#                                         # measured from a provider's *text*
#                                         # model, so without it a brief text
#                                         # hiccup would quietly send every image
#                                         # to the key-less renderer, which is
#                                         # heavily rate limited. Pollinations
#                                         # stays the eligible fallback either way,
#                                         # and a renderer that is genuinely
#                                         # failing can still be overtaken.
#                                         # Leaving this false is correct for a
#                                         # free-tier key: Google's free tier
#                                         # grants zero image quota.
# GEMINI_API_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
#                                         # verification seam only: point the real
#                                         # adapter at a fixture that speaks the
#                                         # same response shape, so the image path
#                                         # can be exercised where no key has image
#                                         # quota. Unset in normal use.
# MEDIA_MAX_PROMPT_CHARS=1000
# MEDIA_MAX_IMAGES_PER_REQUEST=4         # one provider call per variation
# MEDIA_MAX_ASSETS_PER_USER=200
#
# A key-less public image endpoint (Pollinations). Registering it is opt-in: it
# renders prompts on someone else's servers, so ISOBASH only offers it when a
# deployment explicitly enables it. With it enabled the router has a real second
# image renderer even when the cloud provider's quota is zero.
# POLLINATIONS_ENABLED=true
# POLLINATIONS_MODEL="flux"
# POLLINATIONS_BASE_URL="https://image.pollinations.ai"
# POLLINATIONS_TIMEOUT_MS=120000
# MEDIA_MAX_IMAGE_BYTES=20971520         # 20 MiB per stored image
# MEDIA_MAX_TOTAL_BYTES_PER_USER=104857600 # 100 MiB of media per account
# MEDIA_ASPECT_RATIOS="1:1,3:4,4:3,9:16,16:9"
# MEDIA_MAX_GENERATIONS_PER_HOUR=20      # per account, on top of the IP rate limit
#
# ---------------------------------------------------------------------------
# Video generation (Phase 14)
# ---------------------------------------------------------------------------
# Video is a separate provider from the key-less image one on purpose:
# Pollinations now requires an API key on *every* generation endpoint, so the
# video capability cannot share the anonymous image adapter. Registering video
# against a key-less provider would make `capabilities.video.available` a claim
# this app cannot keep, so the provider is registered as available-but-
# unconfigured when the key is missing instead of quietly answering 401.
#
# The limits are separate from the image ones because a clip is two orders of
# magnitude larger than a still and takes minutes, not seconds, to render.
# MEDIA_VIDEO_MAX_PROMPT_CHARS=1000
# MEDIA_VIDEO_MAX_BYTES=104857600         # 100 MiB per stored clip
# MEDIA_VIDEO_DURATIONS="4,6,8"           # an allow-list, not a range: video
#                                         # models do not accept every length
# MEDIA_VIDEO_ASPECT_RATIOS="16:9,9:16,1:1"
# MEDIA_VIDEO_GENERATIONS_PER_HOUR=6      # per account
# MEDIA_VIDEO_MAX_CONCURRENT=1            # renders in flight for the whole
#                                         # process: a render holds a provider
#                                         # connection open for minutes
#
# POLLINATIONS_VIDEO_ENABLED=true         # opt-in: prompts and first frames are
#                                         # sent to a third party
# POLLINATIONS_VIDEO_API_KEY="set-locally-only"
#                                         # falls back to POLLINATIONS_API_KEY
# POLLINATIONS_VIDEO_MODEL="google/veo-3.1-fast"
# POLLINATIONS_VIDEO_BASE_URL="https://gen.pollinations.ai"
#                                         # overridable so the adapter can be
#                                         # exercised against a fixture that
#                                         # speaks the same response shape
# POLLINATIONS_VIDEO_TIMEOUT_MS=300000    # 5 min: a render that has not
#                                         # answered by now has failed
# POLLINATIONS_VIDEO_UPLOAD_TIMEOUT_MS=60000
# POLLINATIONS_VIDEO_MAX_BYTES=209715200  # 200 MiB download ceiling
#
# MAGIC HOUR VIDEO
# ---------------------------------------------------------------------------
# Read this before enabling it.
#
# Magic Hour bills one shared pool per API key. The free plan is 400 credits a
# month for the whole account, so a clip is a shared resource for every ISOBASH
# user, not a per-user allowance. At 24 credits per second, a 4 second 480p clip
# costs 96 credits: about three clips a month in total.
#
# Free plan also means: 480p maximum, watermarked output, and only the
# `ltx-2.5` and `minimax-h3` models. Anything else is rejected by the provider
# rather than by ISOBASH.
#
# The adapter refuses a render that would take the pool below
# MAGICHOUR_CREDIT_RESERVE, so the last credits are not spent on a render that
# cannot complete. `/admin` shows the month to date.
# ---------------------------------------------------------------------------
# MAGICHOUR_ENABLED=true                   # opt-in: prompts and first frames are
#                                         # uploaded to a third party
# MAGICHOUR_API_KEY="set-locally-only"
#                                         # never exposed to the frontend
#                                         # MAGICHOUR_MONTHLY_CREDIT_BUDGET=400    # what the plan grants;
#                                         # the reserve is measured against this,
#                                         # not against a hardcoded 400
# MAGICHOUR_CREDIT_RESERVE=50             # keep this many credits in hand so a
#                                         # long render cannot start and then
#                                         # be unable to finish
# MAGICHOUR_VIDEO_ALLOWED_MODELS="ltx-2.5,minimax-h3"
#                                         # the FIRST entry is the default model
#                                         # and every entry must be one the
#                                         # account can actually pay for
# MAGICHOUR_VIDEO_RESOLUTION="480p"       # the free plan's ceiling
# MAGICHOUR_VIDEO_BASE_URL="https://api.magichour.ai"
#                                         # overridable so the adapter can be
#                                         # exercised against a fixture that
#                                         # speaks the same response shape
# MAGICHOUR_VIDEO_POLL_INTERVAL_MS=5000   # docs allow 3-10s; backs off to 10s
# MAGICHOUR_VIDEO_TIMEOUT_MS=600000       # 10 min: project time ceiling. A
#                                         # timeout is not a failed render, so
#                                         # the run keeps the project id
# MAGICHOUR_VIDEO_UPLOAD_TIMEOUT_MS=60000
# MAGICHOUR_VIDEO_DOWNLOAD_TIMEOUT_MS=120000
# MAGICHOUR_VIDEO_MAX_BYTES=209715200     # 200 MiB download ceiling

# ---------------------------------------------------------------------------
# DEEPAI -- a second AI video renderer, and an optional image one.
#
# NOT A FREE TIER, AND THIS IS THE PART TO READ BEFORE ENABLING IT.
#
# DeepAI's video APIs are "included with DeepAI Pro", which is a paid
# subscription. A valid key without an active Pro subscription is refused with
# HTTP 403, and ISOBASH says so in the error rather than reporting a generic
# failure. Image generation is billed at 1 credit per call from the same
# subscription, so it is not free either and is not offered as a fallback to
# Gemini or Pollinations.
#
# The two video modes draw on SEPARATE monthly allowances, and they are not
# interchangeable: 25 seconds of `hd` and 8 seconds of `hollywood` per month.
# Audio exists only in `hollywood`, so a render that asks for audio is
# Hollywood and is billed against the smaller pool. There is no env var to pin
# a mode; the mode follows the request, and the two pools are accounted
# separately.
#
# There is no DeepAI balance endpoint for video, so the remaining allowance is
# accounted locally and renders started outside ISOBASH are invisible to it.
# A per-pool monthly ceiling is the remaining piece of work, and it is not
# exposed here rather than documented as if it existed.
#
# Video is registered but NOT ROUTED: the model is listed with `enabled: false`
# so it cannot be selected until a routing decision says when to spend a
# $0.20/second wallet over a 25-second allowance. Setting DEEPAI_ENABLED does
# not enable AI video.
# ---------------------------------------------------------------------------
# DEEPAI_ENABLED=true                      # registers the video and image
#                                         # adapters; video stays unrouted
# DEEPAI_API_KEY="set-locally-only"        # never exposed to the frontend
# DEEPAI_VIDEO_BASE_URL="https://api.deepai.org"
# DEEPAI_VIDEO_POLL_INTERVAL_MS=5000
# DEEPAI_VIDEO_TIMEOUT_MS=600000           # DeepAI's own result links expire
#                                         # after about an hour, so a long wait
#                                         # wastes the render
# DEEPAI_VIDEO_UPLOAD_TIMEOUT_MS=120000    # first frames go as multipart
# DEEPAI_VIDEO_DOWNLOAD_TIMEOUT_MS=120000
# DEEPAI_VIDEO_MAX_BYTES=209715200         # 200 MiB download ceiling
#
# Image generation. Registered at a low priority on purpose, so it cannot
# outrank Gemini or a deliberately enabled Pollinations.
# DEEPAI_IMAGE_ENABLED=true                # default is on with DEEPAI_ENABLED
# DEEPAI_IMAGE_BASE_URL="https://api.deepai.org"
# DEEPAI_IMAGE_TIMEOUT_MS=120000
# DEEPAI_IMAGE_DOWNLOAD_TIMEOUT_MS=60000
# DEEPAI_IMAGE_MAX_BYTES=41943040          # 40 MiB

# ---------------------------------------------------------------------------
# JSON2VIDEO -- a SEPARATE feature that composes a report or summary you
# already have into a finished video.
#
# This is not an AI video renderer and is not on the video failover chain.
# Magic Hour and DeepAI turn a prompt into a generated clip; JSON2Video lays
# out text you wrote, optionally narrates it, and hands back one MP4. It is
# reached only from "turn this report into a video", never from the video
# generation screen, so a routing bug can never swap one for the other. The
# currencies are kept apart too: Magic Hour credits, DeepAI seconds and
# JSON2Video seconds are not comparable numbers.
#
# Free plan, per JSON2Video's own docs: 600 credits that DO NOT RENEW, roughly
# 1 credit per second of output, capped at 1080p and 60 seconds per movie,
# output is watermarked, and free-plan use is non-commercial. Text to speech
# currently costs 0 credits, so narration is free; that is unusual and is
# reported to the UI rather than assumed, because a plan change would make an
# assumed-free narration quietly billable.
#
# Because the grant does not refill, a spent account is spent. There is no
# fallback provider that can assemble instead.
# ---------------------------------------------------------------------------
# JSON2VIDEO_ENABLED=true                  # gates POST /media/assembly
# JSON2VIDEO_API_KEY="set-locally-only"    # never exposed to the frontend
# JSON2VIDEO_BASE_URL="https://api.json2video.com"
# JSON2VIDEO_POLL_INTERVAL_MS=5000
# JSON2VIDEO_TIMEOUT_MS=600000             # whole assembly is awaited, so this
#                                         # is the whole request budget
# JSON2VIDEO_DOWNLOAD_TIMEOUT_MS=120000
# JSON2VIDEO_MAX_BYTES=209715200           # 200 MiB download ceiling
# JSON2VIDEO_MAX_SECONDS=60                # the plan's per-movie ceiling
